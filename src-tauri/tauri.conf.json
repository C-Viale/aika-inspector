{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aika-inspector",
  "version": "0.1.0",
  "identifier": "com.caio.aika-inspector",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aika Inspector",
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob: asset: https://asset.localhost; img-src 'self' asset: https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
